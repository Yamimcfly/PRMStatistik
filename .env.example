# ===================================
# Datenbank-Konfiguration
# ===================================

# Neon PostgreSQL Connection (empfohlen für Produktiv-Umgebung)
# Format: postgresql://username:password@endpoint.neon.tech/dbname?sslmode=require
# Beispiel:
# DATABASE_URL=postgresql://myuser:mypassword@ep-cool-sound-123456.eu-central-1.aws.neon.tech/prmstatistik?sslmode=require

# SQLite (Standard, für lokale Entwicklung)
DATABASE_URL=sqlite:///data/prm_stats.sqlite

# Hinweise:
# - Neon erfordert sslmode=require in der Connection String
# - Ersetzen Sie username, password, endpoint und dbname mit Ihren Neon-Zugangsdaten
# - Die Datenbank muss in Neon bereits existieren

# ===================================
# Station-Konfiguration
# ===================================

# Station (für BCBP/bp Data Raw Heuristik)
STATION_IATA=CGN
